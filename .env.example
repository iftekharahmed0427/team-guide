# Public URL of the app. Used by Better Auth for OAuth callbacks and redirects.
BETTER_AUTH_URL=http://localhost:3000

# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Supabase Postgres ---
# App runtime: Supabase Transaction pooler (port 6543).
#   postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migrations / long-lived servers: Supabase Direct connection (port 5432).
#   postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=
# Leave empty for Supabase (TLS stays on). Set to "disable" only for a local non-TLS Postgres.
DATABASE_SSL=

# Discord OAuth app: https://discord.com/developers/applications -> your app -> OAuth2
# Add this redirect URL there: http://localhost:3000/api/auth/callback/discord
# (and the production equivalent for your domain).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bootstrap admins: emails always allowed to sign in AND granted the admin role.
# Use this to seed the first admin(s); everyone else is invited from the dashboard.
# Comma-separated.
AUTH_BOOTSTRAP_ADMINS=

# --- Supabase storage (private bucket, S3-compatible) ---
# Used to store uploaded screenshots (e.g. review evidence) instead of inlining
# them in the database. From Supabase: Project Settings -> Storage -> S3 access.
STORAGE_ENDPOINT=https://[project-ref].storage.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# --- Game panel (Pterodactyl) lookups: /tools/server, /tools/user, /tools/node ---
# Application API key: panel -> Admin -> Application API. Read-only permissions
# on servers, users and nodes are enough.
PTERO_KEY=
# Shared secret for the X-GH-Bypass header the edge in front of the panel checks.
# Without it the panel answers with a challenge page instead of JSON.
GH_BYPASS_SECRET=
# Panel base URL the API calls are built from.
PTERO_URL=https://panel.gravelhost.com
# Optional: full endpoint overrides, only if the panel does not use the default
# /api/application/{servers,users,nodes} layout.
# PTERO_SERVERS=
# PTERO_USERS=
# PTERO_NODE=

# Where the "open in ..." buttons on lookup results point (public, no secrets).
NEXT_PUBLIC_PANEL_URL=https://panel.gravelhost.com
NEXT_PUBLIC_WHMCS_URL=https://gravelhost.com
